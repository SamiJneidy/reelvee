MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=<app-name>
MONGODB_NAME=reelvee

ENVIRONMENT=PRODUCTION
SECRET_KEY=<long-random-secret>
ALGORITHM=HS256
FRONTEND_URL=https://your-frontend-url
CORS_ORIGINS=https://your-frontend-url,https://localhost:3000
LOG_RENDERER=json
LOG_COMPACT_HTTP_CONTEXT=true
MONGO_QUERY_LOGGING_ENABLED=false
MONGO_SLOW_QUERY_MS=200
MONGO_LOG_ALL_QUERIES=false

MAXIMUM_NUMBER_OF_INVALID_LOGIN_ATTEMPTS=5
ACCESS_TOKEN_EXPIRATION_MINUTES=100
REFRESH_TOKEN_EXPIRATION_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=60
EMAIL_VERIFICATION_OTP_EXPIRATION_MINUTES=10
EMAIL_CHANGE_TOKEN_EXPIRATION_MINUTES=15
USER_INVITATION_TOKEN_EXPIRATION_MINUTES=1440
OTP_EXPIRATION_MINUTES=10
SIGN_UP_COMPLETE_EXPIRATION_DAYS=30

MAIL_USERNAME=user@example.com
MAIL_PASSWORD=password
MAIL_FROM=user@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

AWS_ACCESS_KEY_ID=access-key-id
AWS_SECRET_ACCESS_KEY=secret-access-key
AWS_REGION=aws-region
AWS_BUCKET=aws-bucket
AWS_PRESIGNED_URL_EXPIRATION_SECONDS=300

GEOIP_DB_PATH=GeoLite2-Country.mmdb

GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret
GOOGLE_REDIRECT_URI=https://your-api-host/v1/auth/google/callback
